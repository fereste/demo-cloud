// Pipeline de CI/CD de la demo.
// Cada vez que hay un commit nuevo en el repositorio, Jenkins ejecuta estas etapas en orden.
// Si una etapa falla, las siguientes NO se ejecutan (la versión rota nunca llega a producción).

pipeline {
  agent any

  options {
    timestamps()
    timeout(time: 15, unit: 'MINUTES')
  }

  stages {

    stage('1. Preparar') {
      steps {
        script {
          if (!fileExists('/demo-config/azure.env')) {
            error('No existe config/azure.env. Primero hay que ejecutar 3-crear-infra.ps1')
          }
          sh 'cp /demo-config/azure.env azure.env'
          def cfg = readProperties file: 'azure.env'
          env.RESOURCE_GROUP   = cfg.RESOURCE_GROUP
          env.ACR_NAME         = cfg.ACR_NAME
          env.ACR_LOGIN_SERVER = cfg.ACR_LOGIN_SERVER
          env.APP_NAME         = cfg.APP_NAME
          env.IMAGEN           = "${cfg.ACR_LOGIN_SERVER}/demo-app:${env.BUILD_NUMBER}"
        }
        sh '''
          echo "Commit que se va a desplegar:"
          git log -1 --pretty='  %h  %an  "%s"'
          az account show --query "{suscripcion:name, usuario:user.name}" -o table \
            || { echo "Jenkins no tiene sesión en Azure: ejecutar 2-login-azure.ps1"; exit 1; }
        '''
      }
    }

    stage('2. Construir imagen') {
      steps {
        sh '''
          docker build \
            --build-arg VERSION="$BUILD_NUMBER" \
            --build-arg FECHA="$(date '+%d/%m/%Y %H:%M')" \
            -t "$IMAGEN" .
        '''
      }
    }

    stage('3. Probar') {
      steps {
        // Levanta la imagen recién construida en un contenedor local y le corre las pruebas
        sh '''
          docker rm -f "prueba-$BUILD_NUMBER" > /dev/null 2>&1 || true
          docker run -d --name "prueba-$BUILD_NUMBER" --network demo-net "$IMAGEN"
          sh pruebas/prueba.sh "http://prueba-$BUILD_NUMBER"
        '''
      }
      post {
        always {
          sh 'docker rm -f "prueba-$BUILD_NUMBER" > /dev/null 2>&1 || true'
        }
      }
    }

    stage('4. Publicar imagen en Azure') {
      steps {
        // Sube la imagen al registro privado en la nube (Azure Container Registry)
        sh '''
          az acr login --name "$ACR_NAME"
          docker push "$IMAGEN"
        '''
      }
    }

    stage('5. Desplegar en Azure') {
      steps {
        // Le indica a Azure Container Apps que use la nueva imagen: Azure crea una nueva revisión.
        // La credencial del registro privado ya la dejó cargada 3-crear-infra.ps1; solo se vuelve a cargar si falta.
        // Azure a veces responde con errores transitorios (504, "PolicyEvaluationTimeout"): se reintenta con espera.
        sh '''
          reintentar() {
            n=1
            while true; do
              if "$@"; then return 0; fi
              if [ "$n" -ge 4 ]; then echo "Falló después de $n intentos."; return 1; fi
              echo "Azure respondió con error (intento $n de 4). Reintentando en $((n * 20)) segundos..."
              sleep $((n * 20))
              n=$((n + 1))
            done
          }

          REGISTROS=$(az containerapp show --name "$APP_NAME" --resource-group "$RESOURCE_GROUP" \
            --query "properties.configuration.registries[].server" -o tsv)
          case "$REGISTROS" in
            *"$ACR_LOGIN_SERVER"*) echo "La aplicación ya tiene la credencial del registro $ACR_LOGIN_SERVER." ;;
            *)
              echo "Cargando la credencial del registro en la aplicación..."
              set +x   # que la contraseña no quede escrita en el log
              ACR_PASS=$(az acr credential show --name "$ACR_NAME" --query "passwords[0].value" -o tsv)
              [ -n "$ACR_PASS" ] || { echo "No se pudo obtener la credencial del registro $ACR_NAME"; exit 1; }
              reintentar az containerapp registry set \
                --name "$APP_NAME" \
                --resource-group "$RESOURCE_GROUP" \
                --server "$ACR_LOGIN_SERVER" \
                --username "$ACR_NAME" \
                --password "$ACR_PASS" -o none
              set -x
              ;;
          esac

          reintentar az containerapp update \
            --name "$APP_NAME" \
            --resource-group "$RESOURCE_GROUP" \
            --image "$IMAGEN" \
            --query "properties.latestRevisionName" -o tsv
          URL="https://$(az containerapp show -n "$APP_NAME" -g "$RESOURCE_GROUP" --query properties.configuration.ingress.fqdn -o tsv)"
          echo ""
          echo "=============================================================="
          echo "  Versión $BUILD_NUMBER desplegada en: $URL"
          echo "=============================================================="
        '''
      }
    }
  }

  post {
    success { echo '¡Pipeline exitoso! La nueva versión ya está en la nube.' }
    failure { echo 'El pipeline falló: la versión anterior sigue funcionando en la nube.' }
  }
}
